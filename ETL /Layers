Silver Layer 

CREATE SCHEMA IF NOT EXISTS `seraphic-port-499416-n7.RealState_Silver`
OPTIONS (location = "US");

-- ---------------------------------------------------------------------
-- 1) Projects
-- ---------------------------------------------------------------------
CREATE OR REPLACE TABLE `seraphic-port-499416-n7.RealState_Silver.projects` AS
SELECT
  project_id,
  TRIM(project_name)              AS project_name,
  TRIM(location)                  AS location,
  TRIM(developer_name)            AS developer_name,
  SAFE.PARSE_DATE('%Y-%m-%d', launch_date) AS launch_date,
  SAFE_CAST(delivery_year AS INT64)        AS delivery_year,
  TRIM(unit_types_available)      AS unit_types_available
FROM `seraphic-port-499416-n7.RealState.projects`
WHERE project_id IS NOT NULL;

-- ---------------------------------------------------------------------
-- 2) Units
-- ---------------------------------------------------------------------
CREATE OR REPLACE TABLE `seraphic-port-499416-n7.RealState_Silver.units` AS
SELECT
  unit_id,
  project_id,
  TRIM(unit_type)                    AS unit_type,
  SAFE_CAST(area_sqm AS FLOAT64)     AS area_sqm,
  SAFE_CAST(bedrooms AS INT64)       AS bedrooms,
  SAFE_CAST(bathrooms AS INT64)      AS bathrooms,
  TRIM(floor)                        AS floor,          
  TRIM(finishing_type)               AS finishing_type,
  SAFE_CAST(list_price_egp AS FLOAT64) AS list_price_egp,
  TRIM(status)                       AS status
FROM `seraphic-port-499416-n7.RealState.units`
WHERE unit_id IS NOT NULL;

-- ---------------------------------------------------------------------
-- 3) Brokers
-- ---------------------------------------------------------------------
CREATE OR REPLACE TABLE `seraphic-port-499416-n7.RealState_Silver.brokers` AS
SELECT
  broker_id,
  TRIM(broker_name)                  AS broker_name,
  TRIM(agency_name)                  AS agency_name,
  TRIM(phone)                        AS phone,           
  TRIM(region)                       AS region,
  SAFE.PARSE_DATE('%Y-%m-%d', join_date) AS join_date,
  SAFE_CAST(commission_rate_pct AS FLOAT64) AS commission_rate_pct,
  TRIM(status)                       AS status
FROM `seraphic-port-499416-n7.RealState.brokers`
WHERE broker_id IS NOT NULL;

-- ---------------------------------------------------------------------
-- 4) Marketing Campaigns
-- ---------------------------------------------------------------------
CREATE OR REPLACE TABLE `seraphic-port-499416-n7.RealState_Silver.marketing_campaigns` AS
SELECT
  campaign_id,
  TRIM(campaign_name)                AS campaign_name,
  TRIM(channel)                      AS channel,
  TRIM(target_project_id)            AS target_project_id,
  SAFE.PARSE_DATE('%Y-%m-%d', start_date) AS start_date,
  SAFE.PARSE_DATE('%Y-%m-%d', end_date)   AS end_date,
  SAFE_CAST(budget_egp AS FLOAT64)              AS budget_egp,
  TRIM(status)                                  AS status,
  SAFE_CAST(leads_generated AS INT64)           AS leads_generated,
  SAFE_CAST(customers_who_bought AS INT64)      AS customers_who_bought,
  SAFE_CAST(cost_per_lead_egp AS FLOAT64)       AS cost_per_lead_egp,
  SAFE_CAST(cost_per_customer_egp AS FLOAT64)   AS cost_per_customer_egp,
  SAFE_CAST(lead_to_customer_rate_pct AS FLOAT64) AS lead_to_customer_rate_pct
FROM `seraphic-port-499416-n7.RealState.marketing_campaigns`
WHERE campaign_id IS NOT NULL;

-- ---------------------------------------------------------------------
-- 5) Customers
-- ---------------------------------------------------------------------
CREATE OR REPLACE TABLE `seraphic-port-499416-n7.RealState_Silver.customers` AS
SELECT
  customer_id,
  TRIM(customer_name)                AS customer_name,
  TRIM(phone)                        AS phone,
  TRIM(city)                         AS city,
  TRIM(lead_source)                  AS lead_source,
  SAFE.PARSE_DATE('%Y-%m-%d', registration_date) AS registration_date,
  TRIM(campaign_id)                  AS campaign_id
FROM `seraphic-port-499416-n7.RealState.customers`
WHERE customer_id IS NOT NULL;

-- ---------------------------------------------------------------------
-- 6) Sales
-- ---------------------------------------------------------------------
CREATE OR REPLACE TABLE `seraphic-port-499416-n7.RealState_Silver.sales` AS
SELECT
  sale_id,
  unit_id,
  project_id,
  customer_id,
  broker_id,
  SAFE.PARSE_DATE('%Y-%m-%d', sale_date)      AS sale_date,
  SAFE_CAST(sale_price_egp AS FLOAT64)        AS sale_price_egp,
  TRIM(payment_method)                        AS payment_method,
  SAFE_CAST(down_payment_pct AS FLOAT64)      AS down_payment_pct,
  SAFE_CAST(installment_years AS INT64)       AS installment_years,
  SAFE_CAST(commission_amount_egp AS FLOAT64) AS commission_amount_egp,
  TRIM(commission_status)                     AS commission_status,
  TRIM(sale_status)                           AS sale_status
FROM `seraphic-port-499416-n7.RealState.sales`
WHERE sale_id IS NOT NULL;

-- ---------------------------------------------------------------------
-- 7) Date dimension
-- ---------------------------------------------------------------------
CREATE OR REPLACE TABLE `seraphic-port-499416-n7.RealState_Silver.date_dim` AS
SELECT
  SAFE.PARSE_DATE('%Y-%m-%d', date)  AS date,
  SAFE_CAST(year AS INT64)           AS year,
  SAFE_CAST(month AS INT64)          AS month,
  TRIM(month_name_ar)                AS month_name_ar,
  TRIM(month_year)                   AS month_year,
  TRIM(quarter)                      AS quarter,
  SAFE_CAST(day AS INT64)            AS day,
  TRIM(day_name_ar)                  AS day_name_ar,
  SAFE_CAST(week_of_year AS INT64)   AS week_of_year,
  SAFE_CAST(is_weekend AS BOOL)      AS is_weekend
FROM `seraphic-port-499416-n7.RealState.date_dim`
WHERE date IS NOT NULL;

