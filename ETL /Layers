Gold Layer (Star Schema)

CREATE SCHEMA IF NOT EXISTS `seraphic-port-499416-n7.RealState_Gold_Star`
OPTIONS (location = "US");

-- ---------------------------------------------------------------------
-- FACT: كل صف = عملية بيع واحدة (228 صف)
-- ---------------------------------------------------------------------
CREATE OR REPLACE TABLE `seraphic-port-499416-n7.RealState_Gold_Star.fact_sales` AS
SELECT
  sale_id,
  unit_id,
  project_id,
  customer_id,
  broker_id,           -- ممكن تكون 'بدون بروكر (بيع مباشر)'
  sale_date,
  sale_price_egp,
  payment_method,
  down_payment_pct,
  installment_years,
  commission_amount_egp,
  commission_status,
  sale_status
FROM `seraphic-port-499416-n7.RealState_Silver.sales`;

-- ---------------------------------------------------------------------
-- DIM: المشاريع
-- ---------------------------------------------------------------------
CREATE OR REPLACE TABLE `seraphic-port-499416-n7.RealState_Gold_Star.dim_project` AS
SELECT
  project_id,
  project_name,
  location,
  developer_name,
  launch_date,
  delivery_year,
  unit_types_available
FROM `seraphic-port-499416-n7.RealState_Silver.projects`;

-- ---------------------------------------------------------------------
-- DIM: الوحدات (فيها كل الوحدات، مش بس اللي اتباعت — عشان تقدر تحسب
-- نسبة الإشغال Sell-through Rate بمقارنة اللي في الفاكت بكل الوحدات)
-- ---------------------------------------------------------------------
CREATE OR REPLACE TABLE `seraphic-port-499416-n7.RealState_Gold_Star.dim_unit` AS
SELECT
  unit_id,
  project_id,
  unit_type,
  area_sqm,
  bedrooms,
  bathrooms,
  floor,
  finishing_type,
  list_price_egp,
  status
FROM `seraphic-port-499416-n7.RealState_Silver.units`;

-- ---------------------------------------------------------------------
-- DIM: العملاء (كل الـ 1500 عميل — مش بس اللي اشتروا — عشان تقدر تحسب
-- معدل التحويل بمقارنة العملاء اللي في الفاكت بكل قاعدة العملاء)
-- ---------------------------------------------------------------------
CREATE OR REPLACE TABLE `seraphic-port-499416-n7.RealState_Gold_Star.dim_customer` AS
SELECT
  customer_id,
  customer_name,
  phone,
  city,
  lead_source,
  registration_date,
  campaign_id            -- الحملة اللي جابته، أو 'بدون حملة (مصدر عضوي)'
FROM `seraphic-port-499416-n7.RealState_Silver.customers`;

-- ---------------------------------------------------------------------
-- DIM: البروكرز (بيشمل صف وهمي "بدون بروكر" عشان يتربط بالفاكت من غير
-- ما نخسر عمليات البيع المباشر)
-- ---------------------------------------------------------------------
CREATE OR REPLACE TABLE `seraphic-port-499416-n7.RealState_Gold_Star.dim_broker` AS
SELECT
  broker_id, broker_name, agency_name, phone, region, join_date,
  commission_rate_pct, status
FROM `seraphic-port-499416-n7.RealState_Silver.brokers`

UNION ALL

SELECT
  'بدون بروكر (بيع مباشر)' AS broker_id,
  'بدون بروكر (بيع مباشر)' AS broker_name,
  NULL AS agency_name, NULL AS phone, NULL AS region,
  NULL AS join_date, NULL AS commission_rate_pct, NULL AS status;

-- ---------------------------------------------------------------------
-- DIM: الحملات التسويقية
-- ---------------------------------------------------------------------
CREATE OR REPLACE TABLE `seraphic-port-499416-n7.RealState_Gold_Star.dim_campaign` AS
SELECT
  campaign_id, campaign_name, channel, target_project_id,
  start_date, end_date, budget_egp, status
FROM `seraphic-port-499416-n7.RealState_Silver.marketing_campaigns`

UNION ALL

SELECT
  'بدون حملة (مصدر عضوي)' AS campaign_id,
  'بدون حملة (مصدر عضوي)' AS campaign_name,
  NULL AS channel, NULL AS target_project_id,
  NULL AS start_date, NULL AS end_date, NULL AS budget_egp, NULL AS status;

-- ---------------------------------------------------------------------
-- DIM: التاريخ (يومي متصل — نفس الجدول اللي عملناه قبل كده، بنعيد نسخه هنا)
-- ---------------------------------------------------------------------
CREATE OR REPLACE TABLE `seraphic-port-499416-n7.RealState_Gold_Star.dim_date` AS
SELECT *
FROM `seraphic-port-499416-n7.RealState_Silver.date_dim`
WHERE date BETWEEN '2024-01-01' AND '2026-12-31';
